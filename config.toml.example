# Copy this file to `config.toml` at the repo root to override the defaults
# below. `machine_config()` (src/d3text/models/config.py) reads it. Every key is
# optional, and so is the file itself (a fresh checkout, or CI).
#
# These are per-machine settings, not per-run ones: model hyperparameters live
# in the training config passed to `pdm run train`.

# Megabytes (of 10**6 bytes) of token embeddings to keep in a CPU-side cache,
# so the number here compares directly against `free --si`. 0 = no cache.
# An entry is one row per token of a document — over 400 documents of this
# corpus, mean 14.5 MB and maximum 56 MB — which is why this is not the count
# of documents the key used to name: 4000 of them is 58 GB, and the machine
# that tried it had the run killed with nothing in the log naming the cache.
cpu_embeddings_cache_mb = 0

# Paths to `precompute-embeddings` LMDBs, keyed by the base model each was
# built from — a store is written by exactly one model, and a machine that
# trains more than one needs a path per model, not a config edit each time
# the model changes. The training loop then reads the named base model's
# output from disk instead of recomputing it. A base model with no entry
# here, and with `unfrozen_top_layers = 0` in the training config, is re-run
# over every document the CPU cache above cannot hold, on every epoch and
# every validation pass, for output a frozen trunk cannot change; such a run
# warns at start-up. A store must have been built from the same corpus as
# the encodings HDF5 and with the same window — a document whose row count
# disagrees is embedded live and warned about, once. ~100 GiB per base model
# for the whole corpus. A path with nothing there yet is created and filled
# by the run, each document stored the first time the base model embeds it.
#
# Setting or clearing an entry re-baselines the machine for that base model: a
# stored embedding and a recomputed one differ slightly, a training trajectory
# amplifies that, and no configuration makes the two comparable. Change it
# between experiments, never in the middle of one. The data page of the
# documentation says why.
# [embeddings_store]
# "michiyasunaga/BioLinkBERT-base" = "/data/d3text-embeddings"

# A second kind of store, keyed the same way, for a training config that sets
# `unfrozen_top_layers`: rather than one aggregated row per document, it holds
# one row per window at the boundary between the frozen bottom of the trunk
# and the trainable top layers, so a training step can replay just the top
# layers over a cached prefix instead of running the whole trunk. Its
# provenance additionally records that boundary, so a config trained at a
# different `unfrozen_top_layers` — a different boundary — cannot silently
# read a store built for another one; such a mismatch, or a store already open
# under another boundary in this process, warns once and falls back to a full
# forward, the same as an unset entry does.
# [layer_boundary_store]
# "michiyasunaga/BioLinkBERT-base" = "/data/d3text-layer-boundary"

# Directory holding the external annotated corpora `pdm run evaluate` scores
# the dictionary linker against: `Species-800/`, `enzymeNER/`,
# `expasy-enzyme/enzyme.dat` and `nlp4pheno/export.json` beneath it. That last
# name is this project's, not the publisher's — NLP4Pheno ships several dated
# exports that annotate different spans, so the export scored is the one you
# name there, by copy or symlink. Whichever are present are scored and the rest
# are skipped; unset (the default) skips the whole block, so a machine without
# the downloads still evaluates a checkpoint. The block measures the
# surface-form index, not the checkpoint — the dictionary linker has no learned
# parameters — and building that index costs a 256 MB tail read of the entity
# dump plus a scan of every split, landing at ~1.7 GB resident.
# linking_corpora = "~/Downloads"

# The rest are process-global torch settings, applied by
# `d3text.runtime.configure()` at script start-up (train / tune / evaluate).
# Nothing else touches them, so tests, notebooks, and the precompute scripts
# keep torch's own defaults.

# Precision of float32 matmuls: "highest" (true fp32), "high" (TF32), or
# "medium" (bf16 tensor cores — fastest, and what training has used). This is
# the same setting as `torch.backends.cuda.matmul.allow_tf32`, which is just an
# alias for "high" (on) vs "highest" (off).
float32_matmul_precision = "medium"

# Let cuDNN use TF32 tensor cores in convolutions. Unlike the matmul knob above,
# this one really is separate.
cudnn_allow_tf32 = true

# Set PYTORCH_{CUDA,HIP}_ALLOC_CONF=expandable_segments:True — whichever matches
# the installed torch build — to cut allocator fragmentation. An allocator
# config already present in the environment wins over this.
expandable_segments = true

# Set TOKENIZERS_PARALLELISM: "true" lets the Rust tokenizers parallelize and
# silences the fork warning.
tokenizers_parallelism = true
