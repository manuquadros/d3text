# Copy this file to `config.toml` at the repo root to override the defaults
# below. `machine_config()` (src/d3text/models/config.py) reads it. Every key is
# optional, and so is the file itself (a fresh checkout, or CI).
#
# These are per-machine settings, not per-run ones: model hyperparameters live
# in the training config passed to `pdm run train`.

# How many documents' token embeddings to keep in a CPU-side LRU cache.
# 0 = no cache; a positive int caps the number of cached documents.
cpu_embeddings_cache_size = 0

# Path to a `precompute-embeddings` LMDB. Set it and the training loop reads
# the frozen base model's output from disk instead of recomputing it every
# epoch; leave it unset (the default) and nothing changes. The store must have
# been built from the same corpus as the encodings HDF5 and with the same
# window — a document whose row count disagrees is embedded live and warned
# about, once. ~100 GiB for the whole corpus.
# embeddings_store = "/data/d3text-embeddings"

# Directory holding the external annotated corpora `pdm run evaluate` scores
# the dictionary linker against: `Species-800/`, `enzymeNER/`,
# `expasy-enzyme/enzyme.dat` and `nlp4pheno/export.json` beneath it. That last
# name is this project's, not the publisher's — NLP4Pheno ships several dated
# exports that annotate different spans, so the export scored is the one you
# name there, by copy or symlink. Whichever are present are scored and the rest
# are skipped; unset (the default) skips the whole block, so a machine without
# the downloads still evaluates a checkpoint. The block measures the
# surface-form index, not the checkpoint — the dictionary linker has no learned
# parameters — and building that index reads the 1.1 GB entity dump.
# linking_corpora = "~/Downloads"

# The rest are process-global torch settings, applied by
# `d3text.runtime.configure()` at script start-up (train / tune / evaluate).
# Nothing else touches them, so tests, notebooks, and the precompute scripts
# keep torch's own defaults.

# Precision of float32 matmuls: "highest" (true fp32), "high" (TF32), or
# "medium" (bf16 tensor cores — fastest, and what training has used). This is
# the same setting as `torch.backends.cuda.matmul.allow_tf32`, which is just an
# alias for "high" (on) vs "highest" (off).
float32_matmul_precision = "medium"

# Let cuDNN use TF32 tensor cores in convolutions. Unlike the matmul knob above,
# this one really is separate.
cudnn_allow_tf32 = true

# Set PYTORCH_{CUDA,HIP}_ALLOC_CONF=expandable_segments:True — whichever matches
# the installed torch build — to cut allocator fragmentation. An allocator
# config already present in the environment wins over this.
expandable_segments = true

# Set TOKENIZERS_PARALLELISM: "true" lets the Rust tokenizers parallelize and
# silences the fork warning.
tokenizers_parallelism = true
